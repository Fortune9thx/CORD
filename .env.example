# Studio Dev only. CORD targets chain 61997 and no other network.
VITE_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_EXPLORER=https://explorer-studio-dev.genlayer.com

# Set ONLY after gen_getContractSchema returns a non-empty schema for the address.
# eth_getCode cannot be used: it returns "0x" for a live GenLayer contract.
# While unset, the app shows an honest "not deployed" banner.
VITE_CONTRACT_ADDRESS=

# Deployment only — never commit a real key.
GENLAYER_PRIVATE_KEY=
